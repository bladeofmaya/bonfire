<section class="room-stream"
    aria-labelledby="room-stream-title-<%= room.id %>"
    data-controller="room-stream"
    data-action="visibilitychange@document->room-stream#visibilityChanged turbo:before-cache@document->room-stream#teardown"
    data-room-stream-grant-url-value="<%= helpers.room_stream_playback_grant_path(room) %>"
    data-room-stream-player-origin-value="<%= room.stream_player_origin %>">
  <div class="room-stream__viewport" data-room-stream-target="viewport" data-state="connecting">
    <% if room.stream_poster.attached? %>
      <div class="room-stream__poster-layer" data-room-stream-target="poster">
        <%= helpers.image_tag room.stream_poster, class: "room-stream__poster", alt: "" %>
      </div>
    <% end %>

    <iframe
      class="room-stream__frame"
      src="<%= room.stream_player_url %>"
      title="<%= title %> live stream player"
      allow="autoplay; fullscreen; picture-in-picture"
      referrerpolicy="no-referrer"
      sandbox="allow-scripts allow-same-origin allow-presentation"
      data-room-stream-target="frame"></iframe>
  </div>

  <footer class="room-stream__info">
    <h2 id="room-stream-title-<%= room.id %>" class="room-stream__title txt-medium margin-none"><%= title %></h2>
    <p class="room-stream__status" role="status" aria-live="polite" data-room-stream-target="status">Connecting to stream…</p>
    <%= helpers.render "rooms/show/stream_viewers", room: room, viewers: viewers %>
  </footer>
</section>
