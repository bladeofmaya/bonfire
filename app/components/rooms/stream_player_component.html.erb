<section class="room-stream"
    aria-labelledby="room-stream-title-<%= room.id %>"
    data-controller="room-stream"
    data-action="visibilitychange@document->room-stream#visibilityChanged turbo:before-cache@document->room-stream#teardown"
    data-room-stream-grant-url-value="<%= helpers.room_stream_playback_grant_path(room) %>"
    data-room-stream-player-origin-value="<%= room.stream_player_origin %>"
    data-room-stream-direct-value="<%= direct_player? %>"
    <% if direct_player? %>data-room-stream-media-url-value="<%= media_url %>"<% end %>>
  <div class="room-stream__viewport" data-room-stream-target="viewport" data-state="connecting">
    <% if room.stream_poster.attached? %>
      <div class="room-stream__poster-layer" data-room-stream-target="poster">
        <%= helpers.image_tag room.stream_poster, class: "room-stream__poster", alt: "" %>
      </div>
    <% end %>

    <% if direct_player? %>
      <media-player class="room-stream__player" title="<%= title %>" stream-type="live"
          autoplay muted playsinline load="eager" crossorigin
          data-room-stream-target="player"
          data-action="provider-change->room-stream#configureProvider playing->room-stream#playing waiting->room-stream#waiting error->room-stream#error hls-error->room-stream#hlsError volume-change->room-stream#volumeChanged">
        <media-outlet></media-outlet>
        <div class="room-stream__controls" aria-label="Stream controls" data-controller="lucide">
          <media-play-button class="room-stream__control" aria-label="Play or pause stream">
            <i data-lucide="play" slot="play" aria-hidden="true"></i>
            <i data-lucide="pause" slot="pause" aria-hidden="true"></i>
            <i data-lucide="rotate-ccw" slot="replay" aria-hidden="true"></i>
          </media-play-button>
          <span class="room-stream__controls-spacer"></span>
          <media-mute-button class="room-stream__control" aria-label="Mute or unmute stream">
            <i data-lucide="volume-2" slot="mute" aria-hidden="true"></i>
            <i data-lucide="volume-x" slot="unmute" aria-hidden="true"></i>
          </media-mute-button>
          <label class="room-stream__volume-control">
            <span class="for-screen-reader">Stream volume</span>
            <input class="room-stream__volume" type="range" min="0" max="1" step="0.05" value="1"
                aria-label="Stream volume" data-room-stream-target="volumeInput"
                data-action="input->room-stream#setVolume">
          </label>
          <media-pip-button class="room-stream__control" aria-label="Toggle picture in picture">
            <i data-lucide="picture-in-picture-2" slot="enter" aria-hidden="true"></i>
            <i data-lucide="picture-in-picture-2" slot="exit" aria-hidden="true"></i>
          </media-pip-button>
          <media-fullscreen-button class="room-stream__control" aria-label="Toggle fullscreen">
            <i data-lucide="maximize" slot="enter" aria-hidden="true"></i>
            <i data-lucide="minimize" slot="exit" aria-hidden="true"></i>
          </media-fullscreen-button>
        </div>
      </media-player>
      <button type="button" class="room-stream__sound btn"
          data-room-stream-target="soundButton" data-action="room-stream#watchWithSound">Watch with sound</button>
    <% else %>
      <iframe
        class="room-stream__frame"
        src="<%= room.stream_player_url %>"
        title="<%= title %> live stream player"
        allow="autoplay; fullscreen; picture-in-picture"
        referrerpolicy="no-referrer"
        sandbox="allow-scripts allow-same-origin allow-presentation"
        data-room-stream-target="frame"></iframe>
    <% end %>
  </div>

  <footer class="room-stream__info">
    <h2 id="room-stream-title-<%= room.id %>" class="room-stream__title txt-medium margin-none"><%= title %></h2>
    <p class="room-stream__status" role="status" aria-live="polite" data-room-stream-target="status">Connecting to stream…</p>
    <button type="button" class="room-stream__description-trigger btn"
        popovertarget="<%= helpers.dom_id(room, :stream_description) %>">About</button>
    <%= helpers.render "rooms/show/stream_viewers", room: room, viewers: viewers %>
  </footer>
</section>
