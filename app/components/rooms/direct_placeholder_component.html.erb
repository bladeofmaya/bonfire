<%= helpers.button_to url, class: "direct borderless fill-transparent unpad",
      aria: { label: accessible_label } do %>
  <span class="avatar">
    <%= helpers.image_tag avatar_source, aria: { hidden: "true" } %>
  </span>

  <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
    <span class="txt-nowrap overflow-ellipsis" aria-hidden="true"><%= short_name %></span>
  </span>
<% end %>
