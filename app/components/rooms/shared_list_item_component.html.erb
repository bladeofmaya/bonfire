<%= helpers.link_to_room room,
      id: helpers.dom_id(room, :list), data: { sorted_list_name: sort_key },
      class: [ "sidebar-list-item sidebar-list-item--channel align-center room btn txt-nowrap",
        "unread sidebar-list-item--unread": unread?, "room-list--current": selected? ] do %>
  <span class="overflow-ellipsis"><%= room.name %></span>
<% end %>
