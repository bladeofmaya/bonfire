<div class="message__actions" data-controller="soft-keyboard">
  <%= helpers.tag.details class: "position-relative",
      data: { controller: "popup", action: "keydown.esc->popup#close toggle->popup#toggle click@document->popup#closeOnClickOutside", popup_orientation_top_class: "popup-orientation-top" } do %>
    <summary class="btn btn--icon message__action-btn message__options-btn">
      <%= helpers.image_tag "menu-dots-horizontal.svg", size: 20, class: "colorize--black", aria: { hidden: "true" } %>
      <span class="for-screen-reader">Message options</span>
    </summary>

    <div class="message__actions-menu border shadow" data-popup-target="menu">
      <div class="quick-boosts">
        <% EmojiHelper::REACTIONS.each do |character, title| %>
          <%= helpers.form_with model: [ message, Boost.new ], data: { turbo_frame: helpers.dom_id(message, :boosting), action: "popup#close" } do |form| %>
            <%= helpers.hidden_field_tag "boost[content]", character %>
            <%= form.button type: "submit", title: title, class: "btn message__action-btn", data: { emoji: character } do %>
              <figure class="margin-none boost-character"><%= character %></figure>
              <span class="for-screen-reader"><%= title %></span>
            <% end %>
          <% end %>
        <% end %>

        <%= helpers.link_to helpers.new_message_boost_path(message),
              class: "btn message__action-btn message__boost-btn",
              data: { turbo_frame: helpers.dom_id(message, :new_boost), action: "soft-keyboard#open popup#close" } do %>
          <%= helpers.image_tag "boost.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
          <span class="for-screen-reader">New boost</span>
        <% end %>
      </div>

      <div class="flex flex-wrap border-top margin-block-start-half pad-block-start-half message__actions-grid">
        <% if attachment? %>
          <%= helpers.link_to helpers.rails_blob_path(message.attachment, disposition: "attachment", only_path: true), class: "btn message__action-btn center full-width hide-in-ios-pwa", title: "Download", aria: { label: "Download" } do %>
            <%= helpers.image_tag "download.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
          <% end %>

          <%= helpers.tag.button class: "btn message__action-btn center full-width",
              data: { controller: "web-share", action: "web-share#share", web_share_files_value: helpers.rails_blob_path(message.attachment, only_path: true), web_share_title_value: message.attachment.filename.to_s }, title: "Share", aria: { label: "Share" } do %>
            <%= helpers.image_tag "share.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
          <% end %>
        <% else %>
          <%= helpers.tag.button class: "btn message__action-btn center full-width", data: { action: "reply#reply" }, title: "Reply", aria: { label: "Reply" } do %>
            <%= helpers.image_tag "reply.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
          <% end %>
        <% end %>

        <%= helpers.tag.button class: "btn message__action-btn center full-width", title: "Copy link", aria: { label: "Copy link" }, data: { controller: "copy-to-clipboard", action: "copy-to-clipboard#copy", copy_to_clipboard_success_class: "btn--success", copy_to_clipboard_content_value: permalink_url } do %>
          <%= helpers.image_tag "link.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <% end %>

        <%= helpers.link_to helpers.edit_room_message_path(message.room, message), class: "btn message__action-btn center full-width message__edit-btn",
              data: { turbo_frame: helpers.dom_id(message, :edit) }, title: "Edit", aria: { label: "Edit" } do %>
          <%= helpers.image_tag "pencil.svg", class: "colorize--black", size: 20, aria: { hidden: "true" } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
