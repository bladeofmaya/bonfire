<% @page_title = "Account settings" %>

<% content_for :nav do %>
  <div class="flex-item-justify-start">
    <%= link_back_to_last_room_visited %>
  </div>

  <% if Current.user.administrator? %>
    <div class="flex align-center gap flex-item-justify-end">
      <%= link_to account_bots_path, class: "btn", style: "view-transition-name: chat-bots" do %>
        <%= image_tag "bot.svg", aria: { hidden: "true" }, size: 20 %>
        <span class="for-screen-reader">Set up chat bots</span>
      <% end %>

      <%= link_to edit_account_custom_styles_path, class: "btn", style: "view-transition-name: custom-styles" do %>
        <%= image_tag "art.svg", size: 20, aria: { hidden: "true" } %>
        <span class="for-screen-reader">Custom styles</span>
      <% end %>
    </div>
  <% end %>
<% end %>

<section class="panel panel--wide profile-settings" style="view-transition-name: account-settings"
    data-controller="profile-tabs" data-profile-tabs-default-tab-value="<%= params[:tab] == "emotes" && Current.user.administrator? ? "emotes" : "general" %>">
  <nav class="profile-settings__tabs" role="tablist" aria-label="Account settings">
    <% tabs = [ [ "general", "settings", "General" ], [ "members", "users-round", "Members" ] ] %>
    <% if Current.user.administrator? %>
      <% tabs << [ "emotes", "smile-plus", "Emotes" ] %>
      <% tabs << [ "privacy", "shield-check", "README" ] %>
    <% end %>
    <% tabs.each_with_index do |(name, icon, label), index| %>
      <button type="button" class="profile-settings__tab" id="account-tab-<%= name %>"
          role="tab" aria-controls="account-panel-<%= name %>" aria-selected="<%= index.zero? %>"
          tabindex="<%= index.zero? ? 0 : -1 %>" data-profile-tabs-target="tab"
          data-profile-tabs-name="<%= name %>"
          data-action="click->profile-tabs#change keydown->profile-tabs#navigate">
        <i data-lucide="<%= icon %>" aria-hidden="true"></i>
        <span><%= label %></span>
      </button>
    <% end %>
  </nav>

  <div class="profile-settings__content">
    <section class="profile-settings__panel" id="account-panel-general" role="tabpanel"
        aria-labelledby="account-tab-general" data-profile-tabs-target="panel" data-profile-tabs-name="general">
      <header class="profile-settings__heading">
        <h1>General</h1>
        <p class="txt-subtle">Update your community name, logo, and room permissions.</p>
      </header>

      <% if Current.user.can_administer? %>
        <div class="align-center center avatar__form profile-settings__avatar gap" data-controller="upload-preview">
          <%= form_with model: @account, method: :patch, class: "txt-medium", data: { controller: "form" } do |form| %>
            <label class="btn input--file">
              <%= image_tag "camera.svg", aria: { hidden: "true" }, size: 20 %>
              <%= form.file_field :logo, class: "input", accept: "image/*",
                    data: { action: "upload-preview#previewImage change->form#submit" } %>
              <span class="for-screen-reader">Upload logo</span>
            </label>
          <% end %>

          <%= form_with model: @account, method: :patch, data: { controller: "form" } do |form| %>
            <label class="btn avatar input--file account-logo txt-xx-large">
              <%= image_tag fresh_account_logo_path, role: "presentation", size: 48, data: { upload_preview_target: "image" } %>
              <%= form.file_field :logo, class: "input", accept: "image/*",
                    data: { action: "upload-preview#previewImage change->form#submit" } %>
              <span class="for-screen-reader">Upload logo</span>
            </label>
          <% end %>

          <% if @account.logo.attached? %>
            <%= button_to fresh_account_logo_path, method: :delete, class: "btn btn--negative txt-small avatar__delete-btn" do %>
              <%= image_tag "minus.svg", aria: { hidden: "true" }, size: 20 %>
              <span class="for-screen-reader">Delete logo</span>
            <% end %>
          <% end %>
        </div>

        <%= form_with model: @account, data: { controller: "form" }, class: "profile-settings__fields flex flex-column gap" do |form| %>
          <div class="flex align-center gap">
            <label class="flex align-center gap flex-item-grow">
              <%= form.text_field :name, class: "input txt-large", autocomplete: "off",
                    placeholder: "Name this account", autofocus: true, data: { action: "keydown.enter->form#submit" } %>
            </label>
            <%= form.button class: "btn btn--reversed center", type: "submit" do %>
              <%= image_tag "check.svg", aria: { hidden: "true" }, size: 20 %>
              <span class="for-screen-reader">Save changes</span>
            <% end %>
          </div>
        <% end %>

      <% else %>
        <div class="txt-align-center">
          <%= account_logo_tag style: "txt-xx-large center" %>
          <h2 class="txt-x-large"><%= @account.name %></h2>
        </div>
      <% end %>
    </section>

    <section class="profile-settings__panel" id="account-panel-members" role="tabpanel" hidden
        aria-labelledby="account-tab-members" data-profile-tabs-target="panel" data-profile-tabs-name="members">
      <header class="profile-settings__heading">
        <h1>Members</h1>
        <p class="txt-subtle">Invite people and manage who belongs to this Bonfire.</p>
      </header>
      <div class="pad-inline pad-block-start fill-shade border-radius">
        <% if Current.user.administrator? %>
          <%= render "accounts/invite" %>
          <hr class="margin-block separator full-width" style="--border-style: solid">
        <% end %>
        <menu class="flex flex-column gap margin-none pad">
          <turbo-frame id="account_users">
            <%= render partial: "accounts/users/user", collection: @administrators, as: :user %>
            <% if @administrators.any? && @members.any? %>
              <hr class="separator full-width" style="--border-style: solid">
            <% end %>
            <%= render partial: "accounts/users/user", collection: @members, as: :user %>
            <%= render "accounts/users/next_page_container", page: @page.next_param unless @page.last? %>
          </turbo-frame>
        </menu>
      </div>
    </section>

    <% if Current.user.administrator? %>
      <section class="profile-settings__panel" id="account-panel-emotes" role="tabpanel" hidden
          aria-labelledby="account-tab-emotes" data-profile-tabs-target="panel" data-profile-tabs-name="emotes">
        <header class="profile-settings__heading">
          <h1>Custom emotes</h1>
          <p class="txt-subtle">Add server emotes for message reactions and <code>:shortcode:</code> autocomplete.</p>
        </header>

        <%= form_with model: CustomEmote.new, url: account_custom_emotes_path,
              class: "custom-emotes__form" do |form| %>
          <label class="flex flex-column gap-half flex-item-grow">
            <strong>Shortcode</strong>
            <%= form.text_field :shortcode, class: "input", placeholder: "maya-smirk",
                  required: true, pattern: "[A-Za-z0-9][A-Za-z0-9_-]{1,31}", autocomplete: "off" %>
          </label>
          <label class="flex flex-column gap-half flex-item-grow">
            <strong>Image</strong>
            <%= form.file_field :image, class: "input", required: true, accept: "image/png,image/gif,image/webp" %>
          </label>
          <%= form.button class: "btn btn--reversed", type: "submit" do %>
            <i data-lucide="plus" aria-hidden="true"></i>
            <span>Add emote</span>
          <% end %>
        <% end %>

        <div class="custom-emotes__list">
          <% @custom_emotes.each do |emote| %>
            <article class="custom-emotes__item">
              <%= form_with model: emote, url: account_custom_emote_path(emote),
                    class: "custom-emotes__item-form" do |form| %>
                <%= image_tag rails_blob_path(emote.image, only_path: true), class: "custom-emote custom-emote--preview", alt: "" %>
                <%= form.text_field :shortcode, class: "input", required: true,
                      pattern: "[A-Za-z0-9][A-Za-z0-9_-]{1,31}", aria: { label: "Shortcode" } %>
                <div class="min-width">
                  <%= form.file_field :image, class: "input txt-small", accept: "image/png,image/gif,image/webp",
                        aria: { label: "Replace image for :#{emote.shortcode}:" } %>
                </div>
                <%= form.button class: "btn btn--icon", type: "submit", aria: { label: "Save :#{emote.shortcode}:" } do %>
                  <i data-lucide="save" aria-hidden="true"></i>
                <% end %>
              <% end %>
              <%= button_to account_custom_emote_path(emote), method: :delete,
                    class: "btn btn--negative btn--icon", aria: { label: "Remove :#{emote.shortcode}:" },
                    data: { turbo_confirm: "Remove :#{emote.shortcode}: from the emote picker? Existing uses will remain visible." } do %>
                <i data-lucide="trash-2" aria-hidden="true"></i>
              <% end %>
            </article>
          <% end %>
          <% if @custom_emotes.empty? %>
            <p class="txt-subtle">No custom emotes yet.</p>
          <% end %>
        </div>
      </section>

      <section class="profile-settings__panel" id="account-panel-privacy" role="tabpanel" hidden
          aria-labelledby="account-tab-privacy" data-profile-tabs-target="panel" data-profile-tabs-name="privacy">
        <header class="profile-settings__heading">
          <h1>README</h1>
          <p class="txt-subtle">Introduce your community and publish the rules people must accept before joining.</p>
        </header>

        <%= form_with model: @account, class: "profile-settings__fields readme-editor flex flex-column gap" do |form| %>
          <label for="account_readme">
            <strong>Information and server rules</strong>
          </label>
          <%= form.rich_text_area :readme, class: "input",
                placeholder: "Use headings to organize information about the server, etiquette, privacy, or anything else people should know before joining." %>

          <p class="txt-small txt-subtle margin-none">
            New members must accept these server rules during signup. Include any relevant privacy information, but remember this tool does not replace jurisdiction-specific legal advice.
          </p>

          <% if @account.readme_published_at.present? %>
            <p class="txt-small txt-subtle margin-none">
              Published <%= tag.time @account.readme_published_at.to_fs(:long),
                    datetime: @account.readme_published_at.iso8601,
                    data: { local_time_target: "datetime" } %>
              · Version <%= @account.readme_version %>
            </p>
          <% end %>

          <%= form.button class: "btn btn--reversed center", type: "submit" do %>
            <%= image_tag "check.svg", aria: { hidden: "true" }, size: 20 %>
            <span>Publish README</span>
          <% end %>
        <% end %>
      </section>
    <% end %>
  </div>
</section>

<% content_for :footer do %>
  <div class="txt-align-center center margin-block-double txt-subtle">Bonfire&trade; version <%= version_badge %></div>
<% end %>
