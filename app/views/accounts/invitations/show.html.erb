<%= turbo_frame_tag "account_invitation_dialog" do %>
  <dialog class="dialog invitation-dialog shadow"
      data-controller="dialog" data-dialog-target="dialog" data-action="close->dialog#clear">
    <%= button_tag type: "button",
          class: "btn btn--icon dialog__close",
          aria: { label: "Close invitation" },
          data: { action: "dialog#close" } do %>
      <%= image_tag "remove.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %>
    <% end %>

    <%= account_logo_tag style: "invitation-dialog__logo" %>
    <h2 class="margin-none">Invite people to <%= Current.account.name %></h2>
    <p>Share this private link with people you want to join.</p>

    <%= render "accounts/invite" %>
  </dialog>
<% end %>
