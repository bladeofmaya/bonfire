<!DOCTYPE html>
<html>
  <head>
    <%= page_title_tag %>

    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, interactive-widget=resizes-content">
    <meta name="view-transition" content="same-origin">
    <meta name="color-scheme" content="dark light">
    <meta name="theme-color" content="#181510">
    <meta name="referrer" content="no-referrer">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= current_user_meta_tags %>
    <%= script_aware_action_cable_meta_tag %>

    <%= tag.meta name: "vapid-public-key", content: Rails.configuration.x.vapid.public_key %>
    <%= tag.meta name: "turbo-prefetch", content: "true" %>

    <%= tag.link rel: "manifest", href: webmanifest_path(format: :json) %>
    <%= tag.link rel: "icon", href: fresh_account_logo_path, type: "image/png" %>
    <%= tag.link rel: "apple-touch-icon", href: fresh_account_logo_path %>

    <script nonce="<%= content_security_policy_nonce %>">
      (() => {
        try {
          const preference = localStorage.getItem("bonfire-theme")
          const theme = [ "light", "dark" ].includes(preference) ? preference :
            (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark")
          document.documentElement.dataset.theme = theme
          document.querySelector('meta[name="theme-color"]').content = theme === "light" ? "#fdf8f0" : "#181510"
        } catch (_error) {}
      })()
    </script>

    <%= stylesheet_link_tag :all, "data-turbo-track": "reload" %>
    <%= custom_styles_tag %>

    <%= javascript_importmap_tags %>

    <%= yield :head %>
  </head>

  <body class="<%= body_classes %>"
      data-controller="external-links local-time lightbox theme"
      data-action="turbo:load@document->external-links#refresh turbo:frame-load@document->external-links#refresh turbo:render@document->external-links#refresh turbo:before-stream-render@document->external-links#refreshAfterRender">
    <a href="#main-content" class="skip-navigation btn">Skip to main content</a>

    <nav id="nav">
      <%= yield :nav %>
    </nav>

    <% if flash[:alert] %>
      <%= render Ui::FlashMessageComponent.new(message: flash[:alert], kind: :alert) %>
    <% elsif flash[:notice] %>
      <%= render Ui::FlashMessageComponent.new(message: flash[:notice]) %>
    <% end %>

    <main id="main-content">
      <%= yield %>

      <footer id="footer">
        <%= yield :footer %>
      </footer>
    </main>

    <aside id="channels" data-controller="toggle-class" data-toggle-class-toggle-class="open">
      <%= yield :sidebar %>
    </aside>

    <aside id="sidebar">
      <%= yield :members %>
    </aside>

    <%= render "layouts/lightbox" %>

    <a href="https://github.com/bladeofmaya/bonfire" id="app-logo" target="_blank" aria-label="Bonfire source code on GitHub">
      <%= image_tag "bonfire-icon.png", alt: "Bonfire logo", width: 256, height: 259 %>
    </a>
  </body>
</html>
