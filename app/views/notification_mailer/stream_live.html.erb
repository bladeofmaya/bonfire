<div style="max-width: 640px; margin: 0 auto; font-family: system-ui, sans-serif; color: #27231d;">
  <p style="font-size: 32px; margin: 0 0 20px;" aria-hidden="true">📺</p>
  <p style="margin: 0 0 8px; color: #756d60;">#️⃣ <%= @room.name %></p>
  <h1 style="margin: 0 0 20px; font-size: 24px;"><%= @stream_name %> is live now</h1>
  <p><%= link_to "Watch the stream", room_url(@room), style: "display: inline-block; padding: 12px 18px; border-radius: 8px; background: #27231d; color: white; text-decoration: none;" %></p>
  <p style="margin-top: 32px; color: #756d60; font-size: 14px;">
    You received this because stream-live emails are enabled.
    <%= link_to "Change notification settings", notification_settings_url %>.
  </p>
</div>
