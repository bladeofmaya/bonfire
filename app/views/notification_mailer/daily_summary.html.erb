<div style="max-width: 640px; margin: 0 auto; font-family: system-ui, sans-serif; color: #27231d;">
  <p style="font-size: 32px; margin: 0 0 20px;" aria-hidden="true">🔥</p>
  <h1 style="margin: 0 0 8px; font-size: 24px;">Your Bonfire summary</h1>
  <p style="margin: 0 0 24px; color: #756d60;">Unread activity from <%= @period_on.to_fs(:long) %></p>

  <% @messages_by_room.each do |room, messages| %>
    <section style="margin: 0 0 24px; padding: 18px; border-radius: 10px; background: #f6f1e9;">
      <h2 style="margin: 0 0 12px; font-size: 18px;"><%= room.direct? ? "💬" : "#️⃣" %> <%= room_display_name(room, for_user: @user) %></h2>
      <% messages.last(5).each do |message| %>
        <p style="margin: 0 0 10px;"><strong><%= message.creator.name %>:</strong> <%= truncate(message.plain_text_body, length: 240) %></p>
      <% end %>
      <%= link_to "Open channel with #{pluralize(messages.size, 'new message')}", room_url(room) %>
    </section>
  <% end %>

  <p style="margin-top: 32px; color: #756d60; font-size: 14px;">
    <%= link_to "Change notification settings", notification_settings_url %>.
  </p>
</div>
