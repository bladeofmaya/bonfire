<%= turbo_frame_tag "direct_conversation_dialog", target: "_top" do %>
  <dialog class="dialog direct-conversation-dialog shadow"
      data-controller="dialog" data-dialog-target="dialog" data-action="close->dialog#clear">
    <%= button_tag type: "button",
          class: "btn btn--icon dialog__close",
          aria: { label: "Close edit ping dialog" },
          data: { action: "dialog#close" } do %>
      <%= image_tag "remove.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %>
    <% end %>

    <header class="direct-conversation-dialog__header">
      <h2 class="margin-none">Edit Ping</h2>
      <p class="margin-none">Rename this private conversation. Participants cannot be changed.</p>
    </header>

    <%= form_with model: @room, class: "direct-conversation-dialog__form",
          data: { turbo_frame: "_top" } do |form| %>
      <label>
        <span class="direct-conversation-dialog__label">Conversation name <span>(optional)</span></span>
        <%= form.text_field :name, name: "room[name]", class: "input full-width",
              placeholder: room_display_name(@room), data: { dialog_target: "autofocus" } %>
      </label>

      <section class="direct-conversation-dialog__members" aria-labelledby="ping-participants-heading">
        <h3 id="ping-participants-heading" class="direct-conversation-dialog__label">Participants</h3>

        <div class="direct-conversation-dialog__member-list overflow-y overflow-hide-scrollbar">
          <% @participants.each do |user| %>
            <div class="direct-conversation-dialog__member">
              <figure class="avatar flex-item-no-shrink" style="--avatar-size: 2.5rem;">
                <%= avatar_tag user, loading: :lazy %>
              </figure>
              <strong class="overflow-ellipsis"><%= user.name %></strong>
              <%= image_tag "check.svg", size: 18, aria: { hidden: "true" }, class: "colorize--black" %>
            </div>
          <% end %>
        </div>
      </section>

      <%= button_tag class: "btn btn--reversed direct-conversation-dialog__submit", type: "submit" do %>
        <%= image_tag "check.svg", size: 18, aria: { hidden: "true" } %>
        <span>Save changes</span>
      <% end %>
    <% end %>
  </dialog>
<% end %>
