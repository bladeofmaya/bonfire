<%= sidebar_turbo_frame_tag do %>
  <%= turbo_stream_from :rooms %>
  <%= turbo_stream_from Current.user, :rooms %>

  <div class="sidebar__container channel-list overflow-y overflow-hide-scrollbar"
      data-controller="badge-dot"
      data-badge-dot-unread-class="unread"
      data-action="rooms-list:unread@window->badge-dot#update rooms-list:read@window->badge-dot#update turbo:submit-start->turbo-frame#unpermanize">
    <header class="channel-list__header">
      <% if Current.user.administrator? %>
        <%= render Ui::ContextMenuComponent.new(
              label: "Server menu",
              menu_class: "channel-list__server-menu",
              items: [ { label: "Server Settings", url: edit_account_path, icon: "settings.svg" } ]
            ) do %>
          <%= image_tag fresh_account_logo_path(size: :small),
                class: "channel-list__logo",
                size: 36,
                alt: "" %>
          <strong class="channel-list__account-name overflow-ellipsis"><%= Current.account.name %></strong>
        <% end %>
      <% else %>
        <div class="channel-list__server-identity">
          <%= image_tag fresh_account_logo_path(size: :small),
                class: "channel-list__logo",
                size: 36,
                alt: "" %>
          <strong class="channel-list__account-name overflow-ellipsis"><%= Current.account.name %></strong>
        </div>
      <% end %>

      <% if Current.user.administrator? %>
        <%= link_to account_invitation_path,
              class: "btn btn--icon channel-list__invite",
              aria: { label: "Invite people" },
              title: "Invite people",
              data: { turbo_frame: "account_invitation_dialog", controller: "lucide" } do %>
          <i data-lucide="user-round-plus" aria-hidden="true"></i>
        <% end %>
      <% end %>
    </header>

    <%= turbo_frame_tag "account_invitation_dialog" %>

    <section class="channel-list__section rooms position-relative flex flex-column gap" aria-labelledby="channels-heading">
      <h2 id="channels-heading" class="channel-list__section-title">Channels</h2>
      <%= render "users/sidebars/rooms/shared_list", memberships: @other_memberships %>

      <% if Current.user.administrator? || !Current.account.settings.restrict_room_creation_to_administrators? %>
        <%= link_to new_rooms_open_path, class: "rooms__new-btn btn room align-center gap txt-reversed", aria: { label: "New Chat Room" } do %>
          <%= image_tag "add.svg", size: 20, aria: { hidden: "true" }, style: "view-transition-name: new-room" %>
        <% end %>
      <% end %>
    </section>

    <section class="channel-list__section channel-list__directs" aria-labelledby="direct-messages-heading">
      <h2 id="direct-messages-heading" class="channel-list__section-title">Direct Messages</h2>

      <turbo-frame id="direct_rooms_control" target="_top">
        <div class="directs gap">
          <%= render "users/sidebars/rooms/direct_list",
                memberships: @direct_memberships,
                participants_by_membership: @direct_participants %>
        </div>
      </turbo-frame>
    </section>

    <button class="btn btn--icon sidebar__toggle" data-action="toggle-class#toggle">
      <%= image_tag "menu.svg", size: 20, aria: { hidden: "true" } %>
      <span class="for-screen-reader">Open menu</span>
    </button>
  </div>

  <div class="sidebar__tools user-dock">
    <%= link_to user_path(Current.user), class: "user-dock__profile", aria: { label: "View my profile" } do %>
      <figure class="avatar user-dock__avatar">
        <%= image_tag fresh_user_avatar_path(Current.user), size: 40, aria: { hidden: "true" }, style: "view-transition-name: avatar-#{Current.user.id}" %>
        <span class="user-dock__status" aria-hidden="true"></span>
      </figure>

      <span class="user-dock__identity min-width">
        <strong class="overflow-ellipsis"><%= Current.user.name %></strong>
        <span>Online</span>
      </span>
    <% end %>

    <%= link_to user_profile_path,
          class: "btn btn--icon user-dock__settings",
          aria: { label: "User settings" },
          title: "User settings" do %>
      <%= image_tag "settings.svg", size: 20, aria: { hidden: "true" }, class: "colorize--black" %>
    <% end %>
  </div>
<% end %>
