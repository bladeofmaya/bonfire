<div id="direct_rooms" class="contents" data-controller="sorted-list" data-action="rooms-list:unread@window->sorted-list#updateItem">
  <% memberships.each do |membership| %>
    <%= render "users/sidebars/rooms/direct",
          membership: membership,
          participants: participants_by_membership.fetch(membership.id) %>
  <% end %>
</div>
