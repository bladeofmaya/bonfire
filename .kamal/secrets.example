# Copy this file to .kamal/secrets and choose one source for each secret.
# Never commit .kamal/secrets or place literal secret values in this template.

# Read secrets that have already been exported by the deployment environment.
VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}
SECRET_KEY_BASE=${SECRET_KEY_BASE}
RTMP_HOMEBREW_PRIVATE_KEY=${RTMP_HOMEBREW_PRIVATE_KEY}
RTMP_HOMEBREW_KEY_ID=${RTMP_HOMEBREW_KEY_ID}
RTMP_HOMEBREW_ISSUER=${RTMP_HOMEBREW_ISSUER}
RTMP_HOMEBREW_AUDIENCE=${RTMP_HOMEBREW_AUDIENCE}
RTMP_HOMEBREW_ALLOWED_PLAYER_ORIGINS=${RTMP_HOMEBREW_ALLOWED_PLAYER_ORIGINS}
RTMP_HOMEBREW_EVENT_SECRET=${RTMP_HOMEBREW_EVENT_SECRET}

# 1Password can be used instead. Store item references in private environment
# variables so account, vault, and item names are not published in Git.
# VAPID_PUBLIC_KEY=$(op read "${VAPID_PUBLIC_KEY_OP_REF}")
# VAPID_PRIVATE_KEY=$(op read "${VAPID_PRIVATE_KEY_OP_REF}")
# SECRET_KEY_BASE=$(op read "${SECRET_KEY_BASE_OP_REF}")
