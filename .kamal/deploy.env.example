# Copy to .kamal/deploy.env or run `bin/bonfire setup`.
# This file contains installation-specific configuration, but no secrets.
DEPLOY_HOST=chat.example.com
# Optional SSH/Kamal target. Defaults to DEPLOY_HOST.
DEPLOY_SERVER=203.0.113.10
DEPLOY_SSH_USER=root
DEPLOY_STORAGE_PATH=/var/lib/kamal/bonfire/storage
DEPLOY_STORAGE_UID=1000
KAMAL_SERVICE=bonfire
KAMAL_IMAGE=bonfire
KAMAL_REGISTRY=localhost:5555
KAMAL_BUILDER_ARCH=amd64
